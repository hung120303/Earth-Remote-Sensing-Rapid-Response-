  },
  "promotion_gates": {
    "minimum_pooled_ap_delta": 0.005,
    "strictly_positive_pooled_matched_fpr_recall_delta": true,
    "minimum_each_fold_ap_delta": 0.0,
    "minimum_each_fold_recall_delta": 0.0,
    "minimum_each_sensor_ap_delta": 0.0,
    "paired_group_bootstrap_replicates": 10000,
