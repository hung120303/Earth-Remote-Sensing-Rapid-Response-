{
  "schema_version": 1,
  "status": "frozen_before_selective_proposal_transformer_training",
  "scope": "two-fold, two-seed selective proposal-verifier transformer on authorized MARS folds 3/4",
  "hypothesis": "A transformer trained only on released-positive proposal scenes can learn localized plume morphology and physics without the site/context suppression that caused the current champion to miss transferable released-model positives.",
  "architecture": {
    "input": "9x64x64 frozen spatial maps: released probability mean/max, centered MBMP, B11/B12 differences and normalized differences, cloud fraction, observable fraction",
    "patch_size": 4,
    "dimension": 64,
    "layers": 2,
    "heads": 4,
    "dropout": 0.1,
    "pooling": "observability-masked learned token attention plus released-proposal logit bias, masked global mean, and masked global maximum",
    "sensor_embedding": true,
    "training_population": "released_connected_score > 0.5 in the fitting fold",
    "deployment_route": "released_connected_score > 0.5 and Gaussian+DOFA champion score < 0.25",
    "composition": "max(champion, rescue_weight * mean-seed verifier probability) inside route; champion unchanged elsewhere",
    "rescue_weights": [0.3333333333333333, 0.5],
    "candidate_count": 2
  },
  "training": {
    "crossfit": {"held_3": "fit_4", "held_4": "fit_3"},
    "seeds": [20260816, 20260817],
    "epochs": 12,
    "batch_size": 64,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "gradient_clip": 1.0,
    "pairwise_loss_weight": 0.2,
    "sampling": "equal total mass by label, then equal mass by 25 km group x label x sensor cell",
    "augmentation": "shared random horizontal/vertical flips and 90-degree rotation",
    "endpoint_aggregation": "equal mean of verifier logits over the two seeds"
  },
  "inputs": {
    "spatial_images": {
      "path": "outputs/mars_spatial_scene_inputs_all_folds.npy",
      "sha256": "6530fa2d07d94bd57ba1ac757039dedd18745227e7a476fb0d69f78f996134a5"
    },
    "spatial_metadata": {
